	RewriteRule ^mau-chuc-mung/trang-([0-9]*).html$	index.php?mod=template&type=wish&page=$1&lang=vn [QSA,L]
	
	#trích dẫn
	RewriteRule ^trich-dan.html$	index.php?mod=quote&lang=vn [QSA,L]
	RewriteRule ^trich-dan/trang-([0-9]*).html$	index.php?mod=quote&page=$1&lang=vn [QSA,L]
	
	#thong bao noi bo
