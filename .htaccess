<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTPS} !=on
	RewriteRule ^.*$ https://%{SERVER_NAME}%{REQUEST_URI} [R,L]
	RewriteBase /
	RewriteCond %{HTTP_HOST} ^www\.
	RewriteRule ^(.*)$ https://five-star.c-a.vn/$1 [L,R=301]
	
	ErrorDocument 404 /error.iso
	ErrorDocument 404.html	/error.iso
	RewriteRule ^error.iso$		index.php?mod=home&act=404 [L]
	#--Resize Image
	RewriteRule ^thumb-([0-9]*)-([0-9]*)-(.*)$		thumb.php?w=$1&h=$2&f=$3 [L]
	RewriteRule ^files/thumb/([0-9]*)/([0-9]*)/(.*)$		core/thumbnail/vietisothumb.php?w=$1&h=$2&src=$3 [L]
	RewriteRule ^inc/editor/tiny_mce/plugins/advimage/image.htm$	admin/index.php?mod=editor&act=image [L]

	RewriteRule ^$					index.php?mod=homepage&lang=vn [QSA,L]
	RewriteRule ^/$					index.php?mod=homepage&lang=vn [QSA,L]
	RewriteRule ^help/$				help.html [QSA,L]
	RewriteRule ^live.cfg$			index.php?mod=home&sub=notify&act=live&lang=vn [QSA,L]
	RewriteRule ^list-notify.cfg$   index.php?mod=home&sub=notify&act=notify&lang=vn [QSA,L]
	RewriteRule ^viewer/(.*)$		index.php?mod=viewer&folder_id=$1&lang=vn [QSA,L]
	#RewriteRule ^euro2024$			index.php?mod=home&act=euro2024&lang=vn [QSA,L]
	RewriteRule ^worldcup2026$			index.php?mod=home&act=worldcup2026&lang=vn [QSA,L]
	RewriteRule ^docquyen/$			index.php?mod=stock&lang=vn [QSA,L]
	RewriteRule ^wc2026$			index.php?mod=worldcup&lang=vn [QSA,L]
	
	#Dashboard sale
	RewriteRule ^dashboard/$	index.php?mod=home&sub=dashboard&act=sale&lang=vn [QSA,L]
	
	#Can ho noi bat
	RewriteRule ^can-ho-noi-bat.html$	index.php?mod=home&act=today&lang=vn [QSA,L]
	RewriteRule ^thong-tin/$		index.php?mod=home&sub=project&act=project&lang=vn [QSA,L]
	RewriteRule ^bang-hang/$		index.php?mod=home&sub=project&act=stock_list&lang=vn [QSA,L]
	RewriteRule ^doc-quyen/$		index.php?mod=stock&lang=vn [QSA,L]
	RewriteRule ^tien-ich/$			index.php?mod=home&act=ultilities&lang=vn [QSA,L]
	RewriteRule ^tong-quan/$		index.php?mod=home&act=overview&lang=vn [QSA,L]
	RewriteRule ^marketing.html$	index.php?mod=marketing&lang=vn [QSA,L]
	RewriteRule ^marketing/dang-ky.html$	index.php?mod=marketing&act=regis&lang=vn [QSA,L]
	#- Quiz
	RewriteRule ^trac-nghiem.html$	index.php?mod=quiz&show=manager&lang=vn [QSA,L]
	RewriteRule ^trac-nghiem/me$	index.php?mod=quiz&act=my_quiz&lang=vn&cmd=_list [QSA,L]
	RewriteRule ^trac-nghiem/(.*)-q([0-9]*).html$	index.php?mod=quiz&act=my_quiz&slug=$1&quiz_id=$2&cmd=_detail&lang=vn [QSA,L]
	RewriteRule ^trac-nghiem/add$	index.php?mod=quiz&act=edit&lang=vn [QSA,L]
	RewriteRule ^trac-nghiem/edit/([0-9]*)$	index.php?mod=quiz&act=edit&quiz_id=$1&lang=vn [QSA,L]
	RewriteRule ^trac-nghiem/(.*).html$	index.php?mod=quiz&act=quiz_start&string=$1&lang=vn [QSA,L]

	# Quiz Test (improved tests: video/module/project)
	RewriteRule ^trac-nghiem-test.html$	index.php?mod=quiz_test&lang=vn [QSA,L]
	RewriteRule ^trac-nghiem-test/trang-([0-9]*).html$	index.php?mod=quiz_test&page=$1&lang=vn [QSA,L]
