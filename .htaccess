	RewriteRule ^thong-tin/p([0-9]*)/b([0-9]*)/bu([0-9]*)/(.*)-c([0-9]*).html$		index.php?mod=home&sub=project&act=detail&project_id=$1&block_id=$2&building_id=$3&cat_id=$5&show=building&lang=vn [QSA,L]
