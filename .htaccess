	RewriteRule ^trac-nghiem-test/(.*)-t([0-9]*).html$	index.php?mod=quiz_test&act=my_test&slug=$1&test_id=$2&cmd=_detail&lang=vn [QSA,L]
	RewriteRule ^trac-nghiem-test/take/([0-9]*)$	index.php?mod=quiz_test&act=take&test_id=$1&lang=vn [QSA,L]
	RewriteRule ^trac-nghiem-test/result/([0-9]*)$	index.php?mod=quiz_test&act=result&attempt_id=$1&lang=vn [QSA,L]
