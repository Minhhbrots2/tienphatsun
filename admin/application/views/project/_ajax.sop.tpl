<div class="modal-dialog{if $template eq '_sopItem'} modal-mg{/if}">	<div class="modal-content">		<div class="modal-header">			<a href="javascript:void();" class="closeEv close_pop close"><span>×</span></a>			<h3 class="modal-title"><strong>{$titlePage}</strong></h3>		</div>		{if $template eq '_sopItem'}		<form method="post" action="" enctype="multipart/form-data">			<div class="modal-body">			{if $sop_info.template_type eq '_connect'}				<div class="form-group">					<label for="" class="col-form-label">Địa điểm<span class="text-red">*</span></label>					<input type="text" class="form-control" placeholder="Sân bay nội bài" name="title" value="{$more_information.title}" />				</div>				<div class="form-group">					<label for="" class="col-form-label">Thời gian<span class="text-red">*</span></label>					<input type="text" class="form-control" placeholder="5 phút" name="time_duration" value="{$more_information.time_duration}" />				</div>			{else}				<div class="form-group">					<label for="" class="col-form-label">{$core->get_Lang('Title')}<span class="text-red">*</span></label>					<input type="text" class="form-control" name="title" value="{$oneItem.title}" />				</div>				<div class="form-group row">					<div class="col-md-6">						<label for="" class="col-form-label text-right">{$core->get_Lang('Image')}</label>						<div class="input-group">							<input type="text" class="form-control" name="image" placeholder="Chọn hình ảnh làm icon"								id="isoman_url_sop_item_image_{$sop_item_id}" value="{$more_information.image}">							<div class="input-group-btn">								<button class="btn btn-default ajOpenDialog" isoman_for_id="sop_item_image_{$sop_item_id}"									isoman_val="{$oneItem.image}" isoman_name="sop_item_image_{$sop_item_id}" style="padding:9px 10px 9px">{$core->makeIcon('image')}</button>							</div>							<div class="input-group-btn">								<button class="btn btn-default pick-btn" type="button"">Icon</button>							</div>							<input type="hidden" is_icon="{$is_icon}" class="is_icon" name="is_icon" value="0">						</div>					</div>					<div class="col-md-6">						<label class="col-form-label">Vị trí ảnh</label>						<select class="form-control" name="position">							<option {if $more_information.position eq 'left'}selected{/if} value="left">Trái</option>							<option {if $more_information.position eq 'right'}selected{/if} value="right">Phải</option>							<option {if $more_information.position eq 'center'}selected{/if} value="center">Giữa</option>						</select>					</div>				</div>				<div class="form-group">					<label for="" class="col-form-label text-right">{$core->get_Lang('Content')}</label>					<textarea class="isoTextArea" id="sopItem_content_{$sop_id}"						rows="4" cols="255" style="width:100%">{$more_information.content}</textarea>				</div>			{/if}			</div>			<div class="modal-footer">				<input Type="hidden" name="template_type" value="{$sop_info.template_type}" />				<button type="button" class="btn btn-success pull-right" onClick="$Core.project.pop_save_sop_item(this)"					project_id="{$project_id}" sop_id="{$sop_id}" sop_item_id="{$sop_item_id}">{$core->get_Lang('Save')}</button>				<button type="button" class="btn btn-default mr-half pull-right" data-dismiss="modal">{$core->get_Lang('Close')}</button>			</div>		</form>		{else}		<form method="post" action="" enctype="multipart/form-data">			<div class="modal-body">				<div class="row">					<div class="form-group">						<label class="col-form-label text-right col-md-2">{$core->get_Lang('Title')}							<span class="text-red">*</span>						</label>						<div class="col-md-10">							<input type="text" class="form-control required" name="title" value="{$oneItem.title}" />						</div>					</div>					<div class="form-group">						<label for="field_type" class="col-form-label text-right col-md-2">{$core->get_Lang('Type')}</label>						<div class="col-md-6">							<select class="form-control" name="field_type" id="field_type" onchange="$Core.project.handle_field_type(this)">								<option value="_textarea"{if $oneItem.field_type eq '_textarea'} selected{/if}>Văn bản & Hình ảnh</option>								<option value="_list"{if $oneItem.field_type eq '_list'} selected{/if}>Danh sách</option>							</select>						</div>					</div>					<div class="form-group holder_template_type{if $oneItem.field_type eq '_textarea'} hidden{/if}">						<label for="" class="col-form-label text-right col-md-2">{$core->get_Lang('Template')}</label>						<div class="col-md-6">							<select class="form-control" name="template_type">								<!-- <option value="_tab"{if $oneItem.template_type eq '_tab'} selected{/if}>Tab</option> -->								<option value="_column"{if $oneItem.template_type eq '_column'} selected{/if}>Column</option>								<option value="_connect"{if $oneItem.template_type eq '_connect'} selected{/if}>Kết nối vùng</option>								<option value="_column_text"{if $oneItem.template_type eq '_column_text'} selected{/if}>Column Text</option>								<option value="_carousel"{if $oneItem.template_type eq '_carousel'} selected{/if}>Carousel</option>								<option value="_carousel_text"{if $oneItem.template_type eq '_carousel_text'} selected{/if}>Carousel Text</option>								<option value="_carousel_slider"{if $oneItem.template_type eq '_carousel_slider'} selected{/if}>Carousel Slider</option>								<option value="_gallery_cycle"{if $oneItem.template_type eq '_gallery_cycle'} selected{/if}>Gallery Cycle</option>							</select>						</div>					</div>				</div>			</div>			<div class="modal-footer">				<button type="button" class="btn btn-success pull-right" onClick="$Core.project.pop_save_sop(this, event)"					project_id="{$project_id}" sop_id="{$sop_id}">{$core->get_Lang('Save')}</button>				<button type="button" class="btn btn-default mr-half pull-right" data-dismiss="modal">{$core->get_Lang('Close')}</button>			</div>		</form>		{/if}	</div></div>{literal}<style>.ui-datepicker{z-index: 99999!important}</style>	<script>		$(document).ready(function () {			var _current_icon_input = null;			$(".pick-btn").click(function () {				_current_icon_input = $(this).closest('.col-md-6').find('input.form-control').first();				$Core.popup.open('auto', 'auto', modal_icon, 'choose_icon_modal', 'choose_icon_modal');			});			$(document).on('click', '.btn-confirm-icon', function () {				var modal = $(this).closest(".modal");				var sel = $('.icon-item.selected', modal);				if (!sel.length) {					alert('Vui long chon mot icon!');					return;				}				if (_current_icon_input) {					_current_icon_input.val('bx ' + sel.data('icon'));					$(".is_icon").val(1)				}				$Core.popup.close($('.choose_icon_modal'));			});		});	</script>{/literal}