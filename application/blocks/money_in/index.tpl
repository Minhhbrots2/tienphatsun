<div class="card">
	<div class="card-header d-flex align-items-center justify-content-between">
		<h5 class="card-title mb-0">Doanh thu</h5>
		<small class="text-muted">Từ 01/01/{$smarty.now|date_format:"%Y"} tới {$smarty.now|date_format:"%d/%m/%Y"}</small>
	</div>
	<div class="card-body">
		<div class="form-row row-cols-lg-3 mb-2" gId="{$gId}" data-options='{ldelim}{rdelim}'>
			{foreach from=$list_money_blocks item = _OT key = _OK}
			<div class="col mb-2">
				<div class="p-3 border relative {$_OK} bg-lighter rounded-2">
					<h5 class="mb-1 fs-5 fw-bold">
						{$clsISO->shortNumber($_OT.money)}
						<i title="{$clsISO->priceFormat($_OT.money)} {$clsISO->getRate()}" class='bx bx-help-circle' ></i>
					</h5>
					<hr class="w-px-50 my-2" />
					<span class="text-nowrap">{$_OT.title}</span>
				</div>
			</div>
			{/foreach}
		</div>
	</div>
</div>
